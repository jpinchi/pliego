{
  "name": "pliego",
  "productName": "Pliego",
  "version": "1.1.3",
  "description": "Pliego — Editor de PDF de escritorio",
  "main": "main.js",
  "author": "jpinchi",
  "license": "MIT",
  "scripts": {
    "icon": "node build/make-icon.js",
    "start": "electron .",
    "clean": "node scripts/clean-dist.js",
    "pack": "npm run clean && electron-builder --dir",
    "dist": "npm run clean && electron-builder",
    "dist:win": "npm run clean && electron-builder --win",
    "release": "npm run clean && electron-builder --win --publish always",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.63.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2"
  },
  "build": {
    "appId": "io.github.jpinchi.pliego",
    "productName": "Pliego",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "jpinchi",
      "repo": "pliego"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-splash.js",
      "renderer/**/*",
      "build/icon.*",
      "node_modules/electron-updater/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pliego"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
