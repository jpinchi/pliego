{
  "name": "pliego-splash-src",
  "version": "1.0.0",
  "description": "Remotion source for Pliego splash screen animation",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "render": "remotion render PliegoSplash out/splash.webm --codec=vp9 --pixel-format=yuva420p --image-format=png --fps-override=30",
    "render:quiet": "remotion render PliegoSplashQuiet out/splash-quiet.webm --codec=vp9 --pixel-format=yuva420p --image-format=png --fps-override=30",
    "still:light": "remotion still PliegoSplash out/still-light.png --frame=20 --props={\\\"bg\\\":\\\"#f0f0f0\\\"}",
    "still:dark": "remotion still PliegoSplash out/still-dark.png --frame=20"
  },
  "dependencies": {
    "remotion": "4.0.290",
    "@remotion/cli": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
